#!system = {{@package 'system'}}
#!date = {{now "yyyy-MM-dd HH:mm:ss"}}
#!version = {{version}}
#!system_version = {{ @package 'systemVersion'}}

[Argument]
{{{arguments}}}

[Rewrite]
^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$ mock-response-body data-type=html data-path=https://biliverse.github.io/settings/ status-code=200
^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$ response-header-add Cache-Control no-store
^https:\/\/app\.bilibili\.com\/settings\/index\.mjs(?:\?[^#]*)?$ mock-response-body data-type=javascript data-path=https://biliverse.github.io/settings/index.mjs status-code=200
^https:\/\/app\.bilibili\.com\/settings\/index\.mjs(?:\?[^#]*)?$ response-header-add Cache-Control no-store
^https:\/\/app\.bilibili\.com\/settings\/assets\/Biliverse_subject\.png(?:\?[^#]*)?$ mock-response-body data-type=png data-path=https://biliverse.github.io/settings/assets/Biliverse_subject.png status-code=200
^https:\/\/app\.bilibili\.com\/settings\/assets\/Biliverse_subject\.png(?:\?[^#]*)?$ response-header-add Cache-Control no-store
^https:\/\/app\.bilibili\.com\/settings\/assets\/Enhanced_subject\.png(?:\?[^#]*)?$ mock-response-body data-type=png data-path=https://biliverse.github.io/settings/assets/Enhanced_subject.png status-code=200
^https:\/\/app\.bilibili\.com\/settings\/assets\/Enhanced_subject\.png(?:\?[^#]*)?$ response-header-add Cache-Control no-store
^https:\/\/app\.bilibili\.com\/settings\/assets\/Global_subject\.png(?:\?[^#]*)?$ mock-response-body data-type=png data-path=https://biliverse.github.io/settings/assets/Global_subject.png status-code=200
^https:\/\/app\.bilibili\.com\/settings\/assets\/Global_subject\.png(?:\?[^#]*)?$ response-header-add Cache-Control no-store
^https:\/\/app\.bilibili\.com\/settings\/assets\/Redirect_subject\.png(?:\?[^#]*)?$ mock-response-body data-type=png data-path=https://biliverse.github.io/settings/assets/Redirect_subject.png status-code=200
^https:\/\/app\.bilibili\.com\/settings\/assets\/Redirect_subject\.png(?:\?[^#]*)?$ response-header-add Cache-Control no-store
^https:\/\/app\.bilibili\.com\/settings\/assets\/ADBlock_subject\.png(?:\?[^#]*)?$ mock-response-body data-type=png data-path=https://biliverse.github.io/settings/assets/ADBlock_subject.png status-code=200
^https:\/\/app\.bilibili\.com\/settings\/assets\/ADBlock_subject\.png(?:\?[^#]*)?$ response-header-add Cache-Control no-store
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\?.*)?$ mock-response-body data-type=json data-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/BiliBili.Enhanced.boxjs.json status-code=200
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\?.*)?$ response-header-add X-PreferencePanes-Version {{version}} Cache-Control no-store

[Script]
http-request ^https:\/\/biliverse\.github\.io\/settings\/theme\.css(?:\?[^#]*)?$ script-path=https://biliverse.github.io/settings/mock.js, tag=Biliverse.Website
http-request ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/(?:[a-zA-Z0-9_-]+\/?|assets\/(?:index|navigation)\.mjs)(?:\?.*)?$ script-path=https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/web.js, tag=PreferencePanes.Web
http-request ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/(?:get|set|delete)(?:\?.*)?$ requires-body=1, script-path=https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js, tag=PreferencePanes.API
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\? requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js, tag=📺 BiliBili.Enhanced.x.resource.show.tab.v2, argument={{{scriptParams}}}
http-request ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut$ requires-body=1, binary-body-mode=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/request.bundle.js, tag=📺 BiliBili.Enhanced.show.v1.Mixture.RegionShortcut.request.grpc, argument={{{scriptParams}}}
http-response ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList$ requires-body=1, binary-body-mode=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js, tag=📺 BiliBili.Enhanced.show.v1.Mixture.RegionList.response.grpc, argument={{{scriptParams}}}
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\? requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js, tag=📺 BiliBili.Enhanced.x.v2.account.mine, argument={{{scriptParams}}}
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\? requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js, tag=📺 BiliBili.Enhanced.x.v2.region.index, argument={{{scriptParams}}}
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\? requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v{{@package 'version'}}/response.bundle.js, tag=📺 BiliBili.Enhanced.x.v2.channel.region.list, argument={{{scriptParams}}}

[MitM]
hostname = biliverse.github.io, app.bilibili.com, app.biliapi.net, grpc.biliapi.net
