name: "{{@package 'displayName'}} β"
desc: |-
  {{#each (split (@package 'description') "\n")}}
  {{{this}}}
  {{/each}}
openUrl: "{{@package 'openUrl'}}"
author: |-
  {{#each (@package 'contributors')}}
  {{this}}
  {{/each}}
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
category: "{{@package 'organizationName'}}"
date: "{{now "yyyy-MM-dd HH:mm:ss"}}"
version: "{{@package 'version'}}"

http:
  mitm:
    - "app.bilibili.com"
    - "app.biliapi.net"
  script:
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\?
      name: 📺 BiliBili.Enhanced.request.dev
      type: request
      require-body: false
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\?
      name: 📺 BiliBili.Enhanced.response.dev
      type: response
      require-body: true
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\?
      name: 📺 BiliBili.Enhanced.response.dev
      type: response
      require-body: true
    - match: ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\?
      name: 📺 BiliBili.Enhanced.response.dev
      type: response
      require-body: true

script-providers:
  📺 BiliBili.Enhanced.request.dev:
    url: https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/request.dev.bundle.js
    interval: 86400
  📺 BiliBili.Enhanced.response.dev:
    url: https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/response.dev.bundle.js
    interval: 86400
